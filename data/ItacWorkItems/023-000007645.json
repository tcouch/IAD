        "Essays": {
            "Essay": [
                {
                    "EssayTitle": "Novella prima: Si tratteneva nella nobilissima citta' di Bologna... -- Novella seconda: Nella citta' d'Alessandria della Paglia..",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "17761",
                            "RecordID": "022-000004663",
                            "Value": "Loredano,Giovanni Francesco,,1607-1661"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella terza: In Venetia anticamente, ...-- Novella quarta: Nella citta' di Brescia...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "15122",
                            "RecordID": "022-000001163",
                            "Value": "Michiele,Pietro,,fl.1632-1647"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella quinta: Sdegnate l'acque del Tirreno... -- Novella sesta: Rimini citta' nota, ed un tempo assai piu' abbondante...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "17662",
                            "RecordID": "022-000004556",
                            "Value": "Bisaccioni,Maiolino,Count,1582-1663"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella settima: Partenope, citta' fra le principali d'Italia... -- Novella ottava: Clitoneo Floriani cavaliere portoghese...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20078",
                            "RecordID": "022-000007576",
                            "Value": "Croce Bianca ,Giovanni,,"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella nona: In quella parte della bell'Italia, dove con pie' d'argento maestoso passeggia l'Adriatico... -- Novella decima: Svelava nella scena del giorno con la mano di luce...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20077",
                            "RecordID": "022-000007575",
                            "Value": "Rocchi,Giovanni Battista,,"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella undecima: Mente, chi de gli amanti, co i sospiri... -- Novella duodecima: Che nel regno della natura non v'abbia maggior mastro d'invenzioni...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20076",
                            "RecordID": "022-000007574",
                            "Value": "Moroni,Giovanni Battista,,?-1645"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella decimaterza: La reale stirpe di Francia...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20081",
                            "RecordID": "022-000007579",
                            "Value": "Placido Tomasi,Tomaso,,"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella decimaquarta: Fra le citta', che con fortunata ubbidienza riconoscono... -- Novella decimaquinta: Le colline sparse con ben'inteso compartimento...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "19896",
                            "RecordID": "022-000007340",
                            "Value": "Belli,Francesco,,1577-pre1647"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella decimasesta: Non si contano ancora trascorsi molti anni...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20079",
                            "RecordID": "022-000007577",
                            "Value": "Motense,Liberal,,"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella decimasettima: Agisulfo poeta tedesco, di nobile ma povera schiatta...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20080",
                            "RecordID": "022-000007578",
                            "Value": "Pomo,Pietro,,"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella decimaottava: Anicea dama di gran conditioni...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20074",
                            "RecordID": "022-000007572",
                            "Value": "Malipiero,Federico,,1603-1642"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella decimanona: In Napoli citta' gentilissima nacquero al mondo... -- Novella ventesima: Trovavasi per sue faccende in Pisa Armidoro giovane palermitano...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "18575",
                            "RecordID": "022-000005621",
                            "Value": "Brusoni,Girolamo,,1614-1686"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella ventesimaprima: qui capricci che sono conseguenti al genio de giovani... -- Novella ventesima seconda: Nel tempo che il re Alfonso d'Aragona...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20082",
                            "RecordID": "022-000007580",
                            "Value": "Cialdini,Girolamo,,"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella ventesima terzanella fruttifera Italia, sede di nobili citta'... -- Novella ventesima quarta: Si' come io vidi gia' raccontare, hebbe nelle parti di Grecia...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "5495",
                            "RecordID": "022-000000482",
                            "Value": "Campeggi,Annibale,Count,1593-1630"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella ventesima quinta: Su le riviere di Genova habitava una dama di mediocre bellezza... -- Novella ventesima sesta: In Padoa, citta' quanto piu' anitca, tanto piu' nobile...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20075",
                            "RecordID": "022-000007573",
                            "Value": "Pallavicino,Ferrante,,1615-1644"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella ventesima settima: In Verona, citta' fra quelle dell'Italia principalissima...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20073",
                            "RecordID": "022-000007571",
                            "Value": "Pona,Carlo,,"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella ventesima ottava: In una delle principali citta' di Lombardia...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "15135",
                            "RecordID": "022-000001177",
                            "Value": "Berardelli,Alessandro,,"
                        }
                    }
                },
                {
                    "EssayTitle": "Novella ventesima nona: In quell'isola che per esser la pou' fertile... -- Novella trentesima: In quell'anno che i serenissimi gligli Farnesi...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "5017",
                            "RecordID": "022-000000019",
                            "Value": "Carmeni,Francesco,,fl. 1632 - 1671"
                        }
                    }
                },
                {
                    "EssayTitle": "PARTE SECONDA \nN. Prima: Nella nobilissima citta' di Vicenza... -- N. Seconda: Si ritrovo' in Venetia, per godere le delitie del carnevale...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "17761",
                            "RecordID": "022-000004663",
                            "Value": "Loredano,Giovanni Francesco,,1607-1661"
                        }
                    }
                },
                {
                    "EssayTitle": "N terza: Nella citta' di Lisbona, metropoli del regno di Portogallo... -- N. Quarta: Perche' si conosca che quando Amore entra in un animo...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "15122",
                            "RecordID": "022-000001163",
                            "Value": "Michiele,Pietro,,fl.1632-1647"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Quinta: Non era ancora levata l'idolatria de' gentili dal Mondo...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20074",
                            "RecordID": "022-000007572",
                            "Value": "Malipiero,Federico,,1603-1642"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Sesta: Alla colleganza che avevano Cintio e Gilberto di virtu', di sangue e d'affetto... --",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20096",
                            "RecordID": "022-000007596",
                            "Value": "Bissaro,Pietro Paolo,,"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Settima: Non sempre, come alcuni vogliono, si sono le donne mostrate infedeli ai loro mariti... -- N. Ottoava: Si ritrovava in Modona al servitio di quella corte...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20093",
                            "RecordID": "022-000007593",
                            "Value": "Settimo,Giovanni Battista,,"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Nona: Non aveva ancora la malvagita' di velenosa fortuna...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20088",
                            "RecordID": "022-000007588",
                            "Value": "Speranza,Francesco Paolo,,"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Decima: In Fiorenza, citta' che fra le piu' nobili d'talia...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20079",
                            "RecordID": "022-000007577",
                            "Value": "Motense,Liberal,,"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Undecima: Gia' rotti i confini della terra, e spezzati con immpeto i sassi del Vessuvio... -- N. Duodecima: Ardeva di insopportabile amore Belluccia, una delle piu' belle giovani d'Europa...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "17662",
                            "RecordID": "022-000004556",
                            "Value": "Bisaccioni,Maiolino,Count,1582-1663"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Decimaterza: Napoli citta' d'ogni stagione in guisa delitiosa... -- N. Decimaquarta: La Francia quasi deita' biforme...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20080",
                            "RecordID": "022-000007578",
                            "Value": "Pomo,Pietro,,"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Decimaquinta: Affogatosi Federigo Svevo nel viaggio dell'impresa per Terra Santa...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20094",
                            "RecordID": "022-000007594",
                            "Value": "Pasini,Pace,,"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Decimasesta: In Verona, citta' non meno celeste per la bellezza del sito...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20095",
                            "RecordID": "022-000007595",
                            "Value": "Zazzaroni,Paolo,,"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Decimasettima: Purtroppo egli e' vero, che la nostra misera e miserabile humanita'... -- N. Decimaottava: Che una misura, o consonanza di vartie parti scambievolmente proportionate...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "19896",
                            "RecordID": "022-000007340",
                            "Value": "Belli,Francesco,,1577-pre1647"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Decimanona: Soggiornava nella citta' di Venetia faccia della casa d'un giovine studente...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20089",
                            "RecordID": "022-000007589",
                            "Value": "da Canale,Gabriello,,"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Vigesima: D'Argeo e di Telesilla principi D'Aandro, nacque al mondo Euristeo...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "18575",
                            "RecordID": "022-000005621",
                            "Value": "Brusoni,Girolamo,,1614-1686"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Vigesimaprima: Ennio giovine siracusano, giunse co i tratti vivavci della poetica penna... -- N. Vigesimaseconda: Odorisi il miniator d'Ugubbio, citta' nella marca d'Ancona...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "15989",
                            "RecordID": "022-000002557",
                            "Value": "Bertanni,Giovanni Battista,,late1500-after1645"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Vigesimaterza: Conobbi, non e' gran tempo, in Napoli Ginebardo cavaliere di sublime nascita... -- N. Vigesimaquarta; Con occasione di servire nella corte imperiale, trattenevasi in Vienna Bimauro cavaliere...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20087",
                            "RecordID": "022-000007587",
                            "Value": "Palmerini,Ferrante,,"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Vigesimaquinta: Lungo quel fiume, che nell'animo di Cesare prescrisseroppo angusti confini alla potenza romana...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20090",
                            "RecordID": "022-000007590",
                            "Value": "Boscarino,Giovanni,,"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Vigesimasesta: L'amicitia e' quel bene, che serve di sale ad ogni corso di Fortuna...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20082",
                            "RecordID": "022-000007580",
                            "Value": "Cialdini,Girolamo,,"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Vigesimasettima: Costretto dagli accidenti, che a mortali la Fortuna dispensa...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20073",
                            "RecordID": "022-000007571",
                            "Value": "Pona,Carlo,,"
                        }
                    }
                },
                {
                    "EssayTitle": "N. Vigesimaottava: Roma, che nei suoi annali conto' sempremai maravigliose grandezze... -- N. Vigesimanona: Nella nuova Atene, e antica madre degli studi, avvenne un successo, a mio giudicio bellissimo e degno...",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "20086",
                            "RecordID": "022-000007586",
                            "Value": "Santa Croce,Antonio,,"
                        }
                    }
                }
            ]
        },
