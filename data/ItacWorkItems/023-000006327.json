        "Essays": {
            "Essay": [
                {
                    "EssayTitle": "Fra Fulgenzio Arminio detto l`Avvalorato. La Pompa dell`Ossequio, e dell`Affetto. Discorso Sagro nella Solennit\u00e0 della Lettera.\nIn lode dell`Impresa dell`Accademia della Fucina, Discorso dell`Istesso",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "15166",
                            "RecordID": "022-000001208",
                            "Value": "Arminio,Fulgenzio,,"
                        }
                    }
                },
                {
                    "EssayTitle": "D. Agostino Zerbone detto l`Addormentato. In Lode dell`Accademia della Fucina, e sua Impresa. Discorso.",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "19010",
                            "RecordID": "022-000006122",
                            "Value": "Zerbone,Agostino,,"
                        }
                    }
                },
                {
                    "EssayTitle": "D. Nicol\u00f2 Lips\u00f2 detto il Dissonante. Nell`esequie di Cristo nostro Signore. Discorso.\nCur Infans statim, ac ex utero matris egreditur, gemit?",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "18135",
                            "RecordID": "022-000005098",
                            "Value": "Lips\u00f2,Nicol\u00f2,,? - 1661"
                        }
                    }
                },
                {
                    "EssayTitle": "Giuseppe Genovesa detto il Geloso. Per la solennit\u00e0 della Sagra Lettera. Discorso. \nChe la costanza, e la perfezzione dello stato Mondiale dipende dall`incostante vicendevolezza del tempo.",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "18878",
                            "RecordID": "022-000005966",
                            "Value": "Genovesa,Giuseppe,,"
                        }
                    }
                },
                {
                    "EssayTitle": "D. Giovambattista Valdina detto l`Instabile. Il Cannocchiale Siciliano. Orazione Funerale per la morte di D. Giovanni Vintimiglia.\nQuanto sia fallace la speranza di trovar la felicit\u00e0 nella cognizione delle buone discipline, e quanto vana quella d`acquistar gloria, nel possesso delle medesime, e delle belle lettere. Discorso dell`Istesso.",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "19002",
                            "RecordID": "022-000006113",
                            "Value": "Valdina,Giovanni Battista,,1644 - 1695"
                        }
                    }
                },
                {
                    "EssayTitle": "D. Raimondo del Pozzo Principe del PArco detto il Negletto contro gl`amori. Discorso.\nChe l`Unit\u00e0 conserva le Repubbliche, e la division le distrugge. Discorso dell`Istesso.",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "18948",
                            "RecordID": "022-000006050",
                            "Value": "Del Pozzo,Raimondo,,1619 - 1694"
                        }
                    }
                },
                {
                    "EssayTitle": "D. Francesco Alibrando detto il Ripolito. In memoria della Sagra Lettera. Discorso.",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "18812",
                            "RecordID": "022-000005887",
                            "Value": "Alibrando,Francesco,,? - 1702"
                        }
                    }
                },
                {
                    "EssayTitle": "D. Saverio Castelli detto il Loquace. La Piet\u00e0 Atlante, che sostiene le Monarchie. Discorso.",
                    "Contributor": {
                        "ItacPersonItem": {
