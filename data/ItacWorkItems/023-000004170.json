        "Essays": {
            "Essay": [
                {
                    "EssayTitle": "Donne leggiadre a cui l`alto motore",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "16844",
                            "RecordID": "022-000003599",
                            "Value": "Accademici Intronati,,,"
                        }
                    }
                },
                {
                    "EssayTitle": "1) Voi che con gl` occhi ove ha sua stanza Amore; 2) Come al partir del caro unico figlio; 3) Qui dove gia` sol tra sospiri et pianti; 4) Togliendom` il sostegno della vita (Deserto Intronato)",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "16415",
                            "RecordID": "022-000003081",
                            "Value": "Barozzi,Antonio,,"
                        }
                    }
                },
                {
                    "EssayTitle": "1) Quando lunge da voi mi spinse il Cielo; 2) L`alta bellezza e la celeste grazia; 3) Che per me s`oda in ogni parte il suono (Frastagliato Intronato)",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "16821",
                            "RecordID": "022-000003570",
                            "Value": "Sozzini,Fausto,,1539 - 1604"
                        }
                    }
                },
                {
                    "EssayTitle": "La `ve l`Aurora al primo albor rosseggia (Fisicoso Intronato)",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "16419",
                            "RecordID": "022-000003085",
                            "Value": "Lapini,Giovanbattista,,"
                        }
                    }
                },
                {
                    "EssayTitle": "1) Donne fautrici all` Intronato stuolo; 2) Donne s`amor ne` bei vostri occhi al varco; 3) Se m`ascondon le selve et toglion voi; 4) Mentre gia` per il cielo errando il Sole; 5) Dunque non cura piu` dunque non regge (Materiale Intronato)",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "16272",
                            "RecordID": "022-000002924",
                            "Value": "Bargagli,Girolamo,,"
                        }
                    }
                },
                {
                    "EssayTitle": "Vivo in grande e si` cocente fuoco (Scacciato Intronato)",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "16451",
                            "RecordID": "022-000003128",
                            "Value": "Cinuzzi,Marcantonio,,1503 - ca.1590"
                        }
                    }
                },
                {
                    "EssayTitle": "1) La virtu` che fa l`huom chiaro e felice; 2) Hor ch`il ciel piu` che mai lieto e sereno; 3) Chiamando il figlio con voce alta e pia (Accademico Acceso)",
                    "Contributor": {
                        "ItacPersonItem": {
                            "PersonId": "16248",
                            "RecordID": "022-000002896",
                            "Value": "Bargagli,Scipione,,"
                        }
                    }
                }
            ]
        },
